{
  "name": "cold-chain-monitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@cold-chain/web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@cold-chain/web",
    "dev:api": "nodemon --watch api --watch cmd --watch internal --ext ts,json --exec tsx cmd/api/main.ts",
    "build": "npm run build --workspace=@cold-chain/web",
    "start": "tsx cmd/api/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "simulate": "tsx scripts/simulate.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@cold-chain/web"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
